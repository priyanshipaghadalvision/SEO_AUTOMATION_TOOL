# Shared root .env — read by BOTH the Vite frontend and the Express backend.
# Copy to .env and fill in real values. Do not commit .env.

# Backend
PORT=4000
DATABASE_URL=postgresql://seo:seo_dev_password@localhost:5434/seo_automation

# Frontend (must be prefixed VITE_ to be exposed to the browser bundle)
VITE_API_URL=/api

# Auth
JWT_SECRET=generate-with-node-e-require-crypto-randomBytes-48-toString-hex
